generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Maps an Infi customer (from getSession) to their ai-chat enrollment (the
/// credit wallet). `granted` marks that starter credits were issued once.
model Wallet {
  customerId   String   @id
  enrollmentId String
  granted      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

/// Maps a credit-pack invoice to the enrollment to grant on payment.confirmed.
model Purchase {
  invoiceId    String   @id
  enrollmentId String
  createdAt    DateTime @default(now())
}
