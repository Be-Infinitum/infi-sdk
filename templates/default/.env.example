# PostgreSQL (docker compose or local)
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# Infi sandbox credentials (auto-written by create-infi-app)
INFI_SECRET_KEY=sk_test_replace_me
INFI_API_URL=https://api.beinfi.com
NEXT_PUBLIC_INFI_AUTH_BASE_URL=https://app.beinfi.com
INFI_PAY_BASE_URL=https://app.beinfi.com
NEXT_PUBLIC_INFI_APP_SLUG=__APP_SLUG__
INFI_SANDBOX_ID=
INFI_SANDBOX_CLAIM_URL=

# Set by `infi deploy` when registering webhooks
INFI_WEBHOOK_SECRET=

# App display name (shown in UI)
NEXT_PUBLIC_APP_NAME=__APP_NAME__
