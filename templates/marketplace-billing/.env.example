# Local SQLite database
DATABASE_URL="file:./dev.db"

# Server-side secret key from your claimed sandbox (sk_test_...)
INFI_SECRET_KEY=sk_test_replace_me

# Backend API base URL (server-side: exchange + metering + billing)
INFI_API_URL=http://localhost:8088

# Hosted login base URL — the Infi FRONTEND that serves /identity/{slug}/login
# (browser redirects here to log in), NOT the API.
NEXT_PUBLIC_INFI_AUTH_BASE_URL=http://localhost:4003

# App slug the operator login is scoped to (from your sandbox)
NEXT_PUBLIC_INFI_APP_SLUG=marketplace-demo
