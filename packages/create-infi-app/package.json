{
  "name": "create-infi-app",
  "version": "0.1.1",
  "description": "Scaffold a billable Next.js app with Infi \u2014 thin shim over `infi init` (@beinfi/cli)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-infi-app": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@beinfi/cli": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
