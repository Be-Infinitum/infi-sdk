  "dependencies": {
    "@beinfi/sdk": "workspace:*",
    "@beinfi/cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
