# Server-side secret key — used by the /callback route to exchange the auth
# code and by /api/send-code to gate + record the metered send.
INFI_SECRET_KEY=sk_test_replace_me
INFI_API_URL=http://localhost:8088

# Customer id the email-code sends are metered against. Pre-auth flow: there is
# no per-user customer at send time, so /api/send-code meters against the app's
# own budget customer here (send-quota / anti-abuse). Unset → /api/send-code 400s
# and the UsagePanel is hidden.
INFI_METER_CUSTOMER_ID=

# Browser-safe config for the public email-code endpoints.
NEXT_PUBLIC_INFI_API_URL=http://localhost:8088
NEXT_PUBLIC_INFI_AUTH_BASE_URL=http://localhost:8088
NEXT_PUBLIC_INFI_APP_SLUG=sdk-test
