# Local SQLite database
DATABASE_URL="file:./dev.db"

# Server-side secret key from your claimed sandbox (sk_test_...)
INFI_SECRET_KEY=sk_test_replace_me

# Backend API base URL (server-side: exchange + metering)
INFI_API_URL=http://localhost:8088

# Hosted login base URL — the Infi FRONTEND that serves the login page
# (/identity/{slug}/login). The browser goes straight here; in prod this is the
# Infi app host, not the API.
NEXT_PUBLIC_INFI_AUTH_BASE_URL=http://localhost:4003

# App slug the login is scoped to (from your sandbox)
NEXT_PUBLIC_INFI_APP_SLUG=crm-demo

# Hosted checkout (/pay) page — served by the Infi frontend (deal WON → sale).
INFI_PAY_BASE_URL=http://localhost:4003
