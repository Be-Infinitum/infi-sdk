DATABASE_URL="file:./dev.db"

# Anthropic (Claude) for the chat
ANTHROPIC_API_KEY=sk-ant-replace_me

# Infi sandbox
INFI_SECRET_KEY=sk_test_replace_me
INFI_API_URL=http://localhost:8088
# Hosted login is served by the Infi FRONTEND (buildHostedLoginUrl →
# {authBaseUrl}/identity/{slug}/login), so point this at the front, NOT the API.
INFI_AUTH_BASE_URL=http://localhost:3000
INFI_PAY_BASE_URL=http://localhost:3000
INFI_SLUG=ai-chat-demo
INFI_WEBHOOK_SECRET=whsec_replace_me

# The SPA origin (login redirect + checkout return)
APP_URL=http://localhost:5173

# Credit amounts (credits = tokens, 1:1)
STARTER_CREDITS=2000
PACK_CREDITS=50000

# Browser-exposed (Vite) for the embedded <InfiLogin>: app slug + API base for
# the public email-code endpoints.
VITE_INFI_SLUG=ai-chat-demo
VITE_INFI_API_URL=http://localhost:8088
